# Copie ce fichier en .env puis remplis les valeurs.

# ---- Cerveau (IA) ---------------------------------------------
# gemini : gratuit, sans carte bancaire (clé sur aistudio.google.com)
# openai : payant
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Modèle imposé (facultatif) : laisse vide pour un choix automatique.
AI_MODEL=
# Voix de JARVIS sur le PC avec Gemini (voix Microsoft Edge gratuites),
# ex. fr-FR-HenriNeural (homme) ou fr-FR-DeniseNeural (femme).
JARVIS_VOICE=fr-FR-HenriNeural

# ---- Téléphone Android (ADB) -----------------------------------
# Adresse IP:port du téléphone en débogage sans fil (voir README).
# Laisse vide si le téléphone est branché en USB.
ANDROID_ADB_SERIAL=
# Indicatif pays sans le + (ex. 33 France, 223 Mali, 225 Côte d'Ivoire),
# utilisé pour transformer 06 12 34 56 78 en numéro WhatsApp.
PHONE_COUNTRY_CODE=
# com.whatsapp.w4b pour WhatsApp Business
WHATSAPP_PACKAGE=com.whatsapp
# Chemin complet vers adb si adb n'est pas dans le PATH
ADB_PATH=

# ---- Gmail -----------------------------------------------------
GMAIL_ADDRESS=
# Mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ---- Bridge mobile (WebSocket) --------------------------------
ANDROID_BRIDGE_TOKEN=
